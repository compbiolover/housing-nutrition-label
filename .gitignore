.govfin_cache/
.loca2_cache/
.proptax_cache/
.fwi_cache/
.rent_cache/
.schoolmill_cache/

# macOS
.DS_Store

# Claude Code internals (keep shared plugin/marketplace config tracked)
.claude/*
!.claude/settings.json

# Auth / credential files
*.txt
*.pdf
Your Walk Score API Key.pdf

# ACS Summary-File download cache for scripts/build_socio_ref.py
.socio_cache/
# ACS Summary-File download cache for scripts/build_home_value.py
.home_value_cache/
# ACS Summary-File download cache for scripts/build_year_built.py
.yearbuilt_cache/
# Accuracy benchmark fetched by scripts/build_benchmark.py. Deliberately NOT
# committed: Cook County grants no explicit right to redistribute a dataset, so
# the harness fetches ground truth on demand and only the measurements are kept.
.accuracy_cache/

# Census Gazetteer centroid cache for scripts/calibrate_construction_percentiles.py
.gaz_cache/

# NREL ResStock parquet download cache for scripts/build_resstock_eui.py
.resstock_cache/
